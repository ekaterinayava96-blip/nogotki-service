# Контейнер для сервиса «Ноготочки».
#
# Сборка из корня репозитория (важно: контекст — корень, а не backend/,
# потому что сервер отдаёт фронтенд из ../web):
#   docker build -t nogotki .
#
# Версия Node зафиксирована на той же, на которой проект работает локально
# (v26.10.0). Менять её здесь и на сервере нельзя независимо: sqlite в проекте
# встроенный (node:sqlite), и на другой версии поведение может отличаться.
# Проверить, что тег существует: docker pull node:26.10.0-slim
FROM node:26.10.0-slim

# Настройки по умолчанию. Любую можно переопределить при запуске через -e.
# NODE_ENV=production включает проверки из src/config.js: без явного DB_PATH
# приложение откажется стартовать — это защита от молчаливого старта с
# неправильным путём к базе.
ENV NODE_ENV=production \
    PORT=3000 \
    DB_PATH=/data/nogotki.db \
    TRUST_PROXY=1

WORKDIR /app

# Зависимости — отдельным слоем: пока не меняются src/, пересборка кода не
# трогает npm ci. .npmrc с engine-strict копируем, иначе проверка версии Node
# из package.json не сработает.
COPY backend/package.json backend/package-lock.json backend/.npmrc ./backend/
RUN npm ci --omit=dev --prefix backend

# Код бэкенда и фронтенд. Фронтенд нужен целиком: app.js отдаёт web/ из
# каталога уровнем выше backend/src.
COPY backend/src ./backend/src
COPY web ./web

# Каталог под базу. Он же будет смонтирован снаружи (томом) — то, что внутри
# контейнера стирается при каждой пересборке, здесь живёт своей жизнью.
# VOLUME объявлен как напоминание: без монтирования данные пропадут вместе с
# контейнером. Папку создавать вручную не нужно — её создаёт само приложение
# при старте (fs.mkdirSync в src/db/connection.js).
#
# chown нужен для записи от пользователя node. Именованный том наследует
# владельца из образа, поэтому работает сразу; с bind-монтированием папки
# хоста права выставить надо вручную — см. docs/docker-deploy.md.
RUN mkdir -p /data && chown node:node /data
VOLUME ["/data"]

# Служебный пользователь node (не root) — он уже есть в базовом образе.
# Владельцем /data сделать нужно один раз на хосте, иначе запись в базу
# не пройдёт: см. инструкцию docs/docker-deploy.md, раздел «Права на папку».
USER node

EXPOSE 3000

# Проверка живости: /health отвечает, когда схема готова и порт открыт.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:'+(process.env.PORT||3000)+'/health',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"

# Миграции отдельной командой запускать не нужно: приложение применяет их
# само при старте, ДО открытия порта (boot() вызывается раньше app.listen в
# src/index.js). Уже применённые миграции пропускаются по таблице
# schema_migrations.
CMD ["node", "backend/src/index.js"]