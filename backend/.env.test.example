# Тестовый env для самостоятельной проверки админ-раздела.
#
# СЕЙЧАС ФАЙЛА НЕТ: реальные значения лежат в backend/.env.test, который
# игнорируется git (правило `.env.*`). Этот пример — чтобы было видно, какие
# ключи нужны; пароля здесь нет и быть не должно.
#
# Проверка админ-раздела вручную:
#   1. завести пользователя с ролью owner:
#        node src/tools/create-user.js <логин> <пароль> owner
#      (роль owner выдаётся только так — ни форма регистрации, ни эндпоинт API
#      её не выдают)
#   2. положить логин и пароль в backend/.env.test
#   3. войти на /login.html

# Логин тестового администратора (роль owner)
TEST_ADMIN_USERNAME=

# Пароль тестового администратора. НЕ коммитить — только .env.test.
TEST_ADMIN_PASSWORD=