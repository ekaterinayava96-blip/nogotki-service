# Копию этого файла сохрани как .env и заполни реальными значениями.
# .env не попадает в git (см. .gitignore), .env.example — наоборот, обязателен в репозитории.

# Порт, на котором будет работать API
PORT=3000

# Путь к файлу базы данных SQLite (относительно папки backend/ или абсолютный)
DB_PATH=data/nogotki.db

# Окружение: development | production | test
NODE_ENV=development

# Число доверенных reverse-proxy перед приложением (nginx и т.п.).
# Нужно, чтобы лимит попыток входа и req.ip видели IP реального клиента,
# а не адрес прокси. 0/пусто — приложение слушает напрямую; за одним
# прокси ставьте 1, за цепочкой — число звеньев.
# TRUST_PROXY=1

# Срок жизни токена доступа в секундах (по умолчанию 7 суток)
# AUTH_TTL_SECONDS=604800
#
# Токены выписываются как случайные значения; в базе (auth_sessions) хранится
# только их SHA-256, поэтому секрет подписи не нужен. Пароли пользователей
# хешируются встроенным crypto.scrypt (параметры стойкости вместе с хешем).
# API регистрирует только клиентов (роль client); учётка владельца (owner)
# заводится через npm run db:seed либо прямой вставкой в users/user_roles.

# Пароли учёток для npm run db:seed (admin/master/client). В development
# берутся dev-значения по умолчанию; в production ОБЯЗАТЕЛЬНЫ — иначе сид
# не выполнится (fail-fast), чтобы не создавалась слабая демо-учётка.
# SEED_ADMIN_PASSWORD=
# SEED_MASTER_PASSWORD=
# SEED_CLIENT_PASSWORD=

# --- Продакшен (важно!) ---
# При NODE_ENV=production приложение НЕ стартует, пока не заполнены:
#   DB_PATH     — обязательно (явный путь до файла базы).
# NODE_ENV=production на боевом сервере задавайте в обязательном порядке —
# проверка выполняется в src/config.js при каждом старте (fail-fast).