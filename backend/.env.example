# Копию этого файла сохрани как .env и заполни реальными значениями.
# .env не попадает в git (см. .gitignore), .env.example — наоборот, обязателен в репозитории.

# Порт, на котором будет работать API
PORT=3000

# Путь к файлу базы данных SQLite (относительно папки backend/ или абсолютный)
DB_PATH=data/nogotki.db

# Окружение: development | production | test
NODE_ENV=development

# Число доверенных reverse-proxy перед приложением (nginx и т.п.).
# Нужно, чтобы лимит попыток входа и req.ip видели IP реального клиента,
# а не адрес прокси. 0/пусто — приложение слушает напрямую; за одним
# прокси ставьте 1, за цепочкой — число звеньев.
# TRUST_PROXY=1

# Срок жизни токена доступа в секундах (по умолчанию 7 суток)
# AUTH_TTL_SECONDS=604800
#
# Токены выписываются как случайные значения; в базе (auth_sessions) хранится
# только их SHA-256, поэтому секрет подписи не нужен. Пароли пользователей
# хешируются встроенным crypto.scrypt (параметры стойкости вместе с хешем).
# API регистрирует только клиентов (роль client); учётка владельца (owner)
# заводится через npm run db:seed либо прямой вставкой в users/user_roles.

# Пароли учёток для npm run db:seed (admin/master/client). В development
# берутся dev-значения по умолчанию; в production ОБЯЗАТЕЛЬНЫ — иначе сид
# не выполнится (fail-fast), чтобы не создавалась слабая демо-учётка.
# SEED_ADMIN_PASSWORD=
# SEED_MASTER_PASSWORD=
# SEED_CLIENT_PASSWORD=

# --- Внешний вход через Яндекс ---
#
# ВНИМАНИЕ, ЭТО ВРЕМЕННОЕ РЕШЕНИЕ. НА СЕРВЕРЕ ТАК ВКЛЮЧАТЬ НЕЛЬЗЯ.
#
# Сервис в Яндексе ещё НЕ зарегистрирован: у приложения нет постоянного
# адреса, на который Яндекс смог бы вернуть пользователя, поэтому настоящий
# обмен кодами невозможен. Собран наш конец входа, а вместо обращения к Яндексу
# подставляется заглушка: она подставляет тестовую почту и имя и пускает в
# аккаунт БЕЗ проверки у Яндекса. Кто угодно, кто знает эти значения, войдёт.
#
# Заглушка по умолчанию ВЫКЛЮЧЕНА. Пока включена — только для локальной проверки.
# YANDEX_STUB=1

# Обязательны вместе с YANDEX_STUB=1. Без почты приложение не стартует.
# YANDEX_STUB_EMAIL=anna@example.ru
# YANDEX_STUB_NAME=Анна Иванова

# Настоящее подключение: заполнить после публикации сервиса в Яндексе.
# Тогда YANDEX_STUB нужно выключить.
# YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=
# YANDEX_REDIRECT_URI=https://example.ru/api/auth/external/yandex

# --- Резервное копирование базы ---
#
# Приложение снимает копию САМО, по расписанию. Планировщик ОС (cron,
# Планировщик заданий) больше не нужен — раньше он был описан в комментарии,
# но на сервере не настроен, и копий не существовало вовсе.
#
# Как часто снимать копию, в часах. По умолчанию 24 (раз в сутки).
# Значение 0 отключает копирование совсем.
# BACKUP_INTERVAL_HOURS=24

# Сколько последних копий хранить. По умолчанию 14 (две недели ежедневных).
# BACKUP_KEEP=14

# Снимать ли копию сразу при запуске сервера, не дожидаясь первого интервала.
# Полезно, когда сервер поднимают часто: страховка появляется в первый же час.
# 0 — не снимать (тогда первая копия через BACKUP_INTERVAL_HOURS).
# BACKUP_ON_START=1

# --- Продакшен (важно!) ---
# При NODE_ENV=production приложение НЕ стартует, пока не заполнены:
#   DB_PATH     — обязательно (явный путь до файла базы).
# NODE_ENV=production на боевом сервере задавайте в обязательном порядке —
# проверка выполняется в src/config.js при каждом старте (fail-fast).