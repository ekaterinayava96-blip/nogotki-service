# Копию этого файла сохрани как .env и заполни реальными значениями.
# .env не попадает в git (см. .gitignore), .env.example — наоборот, обязателен в репозитории.

# Порт, на котором будет работать API
PORT=3000

# Путь к файлу базы данных SQLite (относительно папки backend/ или абсолютный)
DB_PATH=data/nogotki.db

# Окружение: development | production | test
NODE_ENV=development

# Секрет для подписи токенов входа (строка любой длины; в проде — длинное случайное значение)
AUTH_SECRET=

# Логин/пароль владельца админки — создаются при первом запуске
INITIAL_OWNER_USERNAME=
INITIAL_OWNER_PASSWORD=

# --- Продакшен (важно!) ---
# При NODE_ENV=production приложение НЕ стартует, пока не заполнены:
#   AUTH_SECRET — обязательно, строка не короче 16 символов;
#   DB_PATH     — обязательно (явный путь до файла базы).
# NODE_ENV=production на боевом сервере задавайте в обязательном порядке —
# проверка выполняется в src/config.js при каждом старте (fail-fast).