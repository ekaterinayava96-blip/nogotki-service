# Настройки боевого сервиса. Копия ставится НЕ в репозиторий, а в
# /etc/nogotki/nogotki.env, оттуда её читает systemd (EnvironmentFile).
#
#   sudo install -d -m 750 -o root -g nogotki /etc/nogotki
#   sudo cp deploy/nogotki.env.example /etc/nogotki/nogotki.env
#   sudo chown root:nogotki /etc/nogotki/nogotki.env
#   sudo chmod 640 /etc/nogotki/nogotki.env
#   sudo nano /etc/nogotki/nogotki.env     # заполнить SEED_*_PASSWORD
#
# Файл читает сервис от пользователя nogotki, поэтому группа nogotki и права 640.
# В git этот файл не попадает: секреты не должны уезжать в репозиторий.

NODE_ENV=production

# Порт приложения. Наружу его не открывают: трафик принимает nginx.
PORT=3000

# Путь к файлу базы. При NODE_ENV=production обязателен (fail-fast в
# src/config.js). Путь считается от папки backend/, поэтому data/ попадает
# в каталог, который открыт на запись в systemd-юните.
DB_PATH=data/nogotki.db

# Один доверенный reverse-proxy (nginx) впереди. Нужно, чтобы ограничение
# попыток входа и журнал видели IP настоящего клиента, а не адрес nginx.
# Меняйте на 0, только если сервер открыт в интернет напрямую, без nginx.
TRUST_PROXY=1

# Сколько живёт сессия входа (7 суток).
AUTH_TTL_SECONDS=604800

# --- Пароли демо-учёток, которые создаёт npm run db:seed ---
# При NODE_ENV=production эти три переменные ОБЯЗАТЕЛЬНЫ: сид не станет
# создавать учётки с дев-паролями и упадёт с понятной ошибкой.
# Заполняйте ТОЛЬКО на сервере и не переносите в репозиторий.
#
# Сгенерировать надёжный пароль:
#   openssl rand -base64 18
#
# Убедитесь, что все три пароля РАЗНЫЕ: admin/master/client — это разные
# роли, и владелец не должен заходить под мастером, а клиент — под владельцем.
SEED_ADMIN_PASSWORD=
SEED_MASTER_PASSWORD=
SEED_CLIENT_PASSWORD=

# --- После первого входа в панель владельца ---
# 1. Панель владельца: вкладка «Правила» — адрес, телефон, Telegram студии.
#    В сиде стоят демо-значения (Воронеж, тестовые телефоны) — замените своими.
# 2. Панель владельца: вкладки «Услуги», «Мастера», «График» — реальные данные
#    вместо демо-набора. Ненужные услуги и мастера удалите.
# 3. Если в кабинете не нужны демо-записи сида — удалите их (инструкция в
#    docs/deploy.md, раздел «Убрать демо-записи»).
